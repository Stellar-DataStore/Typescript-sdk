# Copy to .env.local (git-ignored) and fill in. For local development only: anything prefixed VITE_ ends up in the
# browser bundle, so never deploy a page with a real access token in it. Use OAuth for public apps.
VITE_STELLARDS_TOKEN=
VITE_STELLARDS_PROJECT=
# VITE_STELLARDS_BASE_URL=https://api.stellards.io
